/dts-v1/;

/ {
	description = "Zephyr and bl31 for r8a779g3-sparrow-hawk";

	images {
		kernel-1 {
			description = "Zephyr";
			data = /incbin/("./_work/zephyr/build/zephyr/zephyr.bin");
			arch = "arm64";
			type = "kernel";
			os = "linux";
			compression = "none";
			load = <0x40000000>;
			entry = <0x40000000>;
			hash-1 {
				algo = "crc32";
			};
		};
		fdt-1 {
			description = "Flattened Device Tree blob";
			data = /incbin/("./_work/zephyr/build/zephyr/zephyr.dtb");
			type = "flat_dt";
			arch = "arm64";
			compression = "none";
			load = <0x50000000>;
			hash-1 {
				algo = "crc32";
			};
		};
		atf-1 {
			description = "ARM Trusted Firmware";
			data = /incbin/("./bl31-sparrow-hawk.bin");
			type = "tfa-bl31";
			arch = "arm64";
			os = "arm-trusted-firmware";
			compression = "none";
			load = <0x46400000>;
			entry = <0x46400000>;
			hash-1 {
				algo = "crc32";
			};
		};
	};

	configurations {
		default = "default";
		default {
			description = "Boot Zephyr";
			kernel = "kernel-1";
			fdt = "fdt-1";
			loadables = "atf-1";
			hash-1 {
				algo = "crc32";
			};
		};
	};
};

